<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.monitor-window-hotkeys" path="/org/gnome/shell/extensions/monitor-window-hotkeys/">
    <key name="move-active-window-to-monitor-1" type="as">
      <default>['&lt;Alt&gt;&lt;Super&gt;X']</default>
      <summary>Move focused window to monitor 1</summary>
    </key>
    <key name="move-active-window-to-monitor-2" type="as">
      <default>['&lt;Alt&gt;&lt;Super&gt;Z']</default>
      <summary>Move focused window to monitor 2</summary>
    </key>
    <key name="move-active-window-to-monitor-3" type="as">
      <default>['&lt;Alt&gt;&lt;Super&gt;C']</default>
      <summary>Move focused window to monitor 3</summary>
    </key>
    <key name="move-active-window-to-monitor-4" type="as">
      <default>[]</default>
      <summary>Move focused window to monitor 4</summary>
    </key>
    <key name="move-active-window-to-monitor-5" type="as">
      <default>[]</default>
      <summary>Move focused window to monitor 5</summary>
    </key>
    <key name="move-active-window-to-monitor-6" type="as">
      <default>[]</default>
      <summary>Move focused window to monitor 6</summary>
    </key>
    <key name="tile-top-half" type="as">
      <default>['&lt;Super&gt;Up', '&lt;Control&gt;&lt;Super&gt;X']</default>
      <summary>Tile focused window to the top half of its monitor</summary>
    </key>
    <key name="tile-bottom-half" type="as">
      <default>['&lt;Control&gt;&lt;Super&gt;W', '&lt;Super&gt;Down']</default>
      <summary>Tile focused window to the bottom half of its monitor</summary>
    </key>
    <key name="tile-left-half" type="as">
      <default>['&lt;Control&gt;&lt;Super&gt;C', '&lt;Super&gt;Left']</default>
      <summary>Tile focused window to the left half of its monitor</summary>
    </key>
    <key name="tile-active-window-right-half" type="as">
      <default>['&lt;Control&gt;&lt;Super&gt;Right']</default>
      <summary>Tile focused window to the right half of its monitor</summary>
    </key>
  </schema>
</schemalist>
